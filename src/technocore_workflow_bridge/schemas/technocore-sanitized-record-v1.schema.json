{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jokazza84/technocore-workflow-bridge/blob/v0.2.0/src/technocore_workflow_bridge/schemas/technocore-sanitized-record-v1.schema.json",
  "title": "Technocore Sanitized Record V1",
  "description": "Validated and display-sanitized bridge record. The content is still UNTRUSTED_DATA and requires human review.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "path",
        "observed_at",
        "body_sha256",
        "peer_certificate_sha256",
        "tls_version",
        "cipher",
        "content_type",
        "method",
        "redirect_followed"
      ],
      "properties": {
        "origin": {"const": "https://technocore.chat"},
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "observed_at": {"type": "string", "format": "date-time", "maxLength": 64},
        "body_sha256": {"$ref": "#/$defs/sha256"},
        "peer_certificate_sha256": {
          "allOf": [
            {"$ref": "#/$defs/sha256"},
            {"not": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}}
          ]
        },
        "tls_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "cipher": {"type": "string", "minLength": 1, "maxLength": 128},
        "content_type": {
          "enum": [
            "application/json",
            "application/json; charset=utf-8",
            "text/plain",
            "text/plain; charset=utf-8"
          ]
        },
        "method": {"const": "GET"},
        "redirect_followed": {"const": false}
      }
    },
    "lobby_provenance": {
      "allOf": [
        {"$ref": "#/$defs/provenance"},
        {
          "properties": {
            "path": {
              "pattern": "^/r/lobby\\?format=json&since=(0|[1-9][0-9]*)&limit=([1-9]|[1-9][0-9]|1[0-9]{2}|200)$"
            },
            "content_type": {
              "enum": ["application/json", "application/json; charset=utf-8"]
            }
          }
        }
      ]
    },
    "patterns_provenance": {
      "allOf": [
        {"$ref": "#/$defs/provenance"},
        {
          "properties": {
            "path": {"const": "/patterns.md"},
            "content_type": {
              "enum": ["text/plain", "text/plain; charset=utf-8"]
            }
          }
        }
      ]
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "changes", "human_review_required"],
      "properties": {
        "profile": {"const": "NFC_VISIBLE_CONTROLS_V1"},
        "changes": {"type": "integer", "minimum": 0, "maximum": 2097152},
        "human_review_required": {"const": true}
      }
    },
    "cursor_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap", "gap_before_first_seq"],
      "properties": {
        "bootstrap": {"type": "boolean"},
        "gap_before_first_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "if": {"properties": {"bootstrap": {"const": false}}},
      "then": {"properties": {"gap_before_first_seq": {"const": 0}}}
    },
    "lobby_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "ts", "from", "text"],
      "properties": {
        "seq": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "ts": {"type": "string", "maxLength": 64},
        "from": {"type": "string", "maxLength": 160},
        "text": {"type": "string", "maxLength": 24576},
        "nonce": {"type": "integer", "minimum": 0, "maximum": 9999999999999999999}
      }
    },
    "lobby": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "origin",
        "room",
        "cursor",
        "cursor_status",
        "dedupe_key",
        "source_record_sha256",
        "trust",
        "provenance",
        "sanitization",
        "untrusted_data"
      ],
      "properties": {
        "schema": {"const": "TECHNOCORE_SANITIZED_RECORD_V1"},
        "origin": {"const": "https://technocore.chat"},
        "room": {"const": "lobby"},
        "cursor": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "cursor_status": {"$ref": "#/$defs/cursor_status"},
        "dedupe_key": {"$ref": "#/$defs/sha256"},
        "source_record_sha256": {"$ref": "#/$defs/sha256"},
        "trust": {"const": "UNTRUSTED_DATA"},
        "provenance": {"$ref": "#/$defs/lobby_provenance"},
        "sanitization": {"$ref": "#/$defs/sanitization"},
        "untrusted_data": {"$ref": "#/$defs/lobby_data"}
      }
    },
    "patterns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "origin",
        "resource",
        "dedupe_key",
        "source_record_sha256",
        "trust",
        "provenance",
        "sanitization",
        "untrusted_data"
      ],
      "properties": {
        "schema": {"const": "TECHNOCORE_SANITIZED_RECORD_V1"},
        "origin": {"const": "https://technocore.chat"},
        "resource": {"const": "patterns"},
        "dedupe_key": {"$ref": "#/$defs/sha256"},
        "source_record_sha256": {"$ref": "#/$defs/sha256"},
        "trust": {"const": "UNTRUSTED_DATA"},
        "provenance": {"$ref": "#/$defs/patterns_provenance"},
        "sanitization": {"$ref": "#/$defs/sanitization"},
        "untrusted_data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": {"type": "string", "maxLength": 1572864}
          }
        }
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/lobby"},
    {"$ref": "#/$defs/patterns"}
  ]
}
